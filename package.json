{
  "name": "sefas-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 80",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "images:check": "node scripts/check-image-names.mjs",
    "postinstall": "node -e \"require('fs').cpSync('node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs','public/vendor/maplibre-gl-worker.mjs')\""
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lenis": "^1.3.27",
    "maplibre-gl": "^6.15.0",
    "next": "^16.4.3",
    "nodemailer": "^10.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.7"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "^1.1.21",
      "js-yaml": "^4.3.2",
      "source-map-js": "^1.2.2"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
